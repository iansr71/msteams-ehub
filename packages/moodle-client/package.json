{
  "name": "@ehub/moodle-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed, sanitized Moodle REST client and file downloader.",
  "type": "module",
  "exports": {
    ".": {
      "@ehub/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "node ../../scripts/clean.mjs dist tsconfig.build.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ehub/shared": "workspace:*",
    "zod": "^4.6.7"
  }
}

{
  "name": "@ehub/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared configuration, logging, redaction and correlation utilities.",
  "type": "module",
  "exports": {
    ".": {
      "@ehub/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./search": {
      "@ehub/source": "./src/search/index.ts",
      "types": "./dist/search/index.d.ts",
      "default": "./dist/search/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "node ../../scripts/clean.mjs dist tsconfig.build.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@azure/identity": "4.13.3",
    "zod": "^4.6.7"
  }
}

# E-Hub Teams Knowledge Assistant — environment variables.
# Copy to .env for local development and fill in values there. Never commit .env.
# Deployed environments read these from Azure Key Vault / app settings, not from a file.

# Runtime
NODE_ENV=
LOG_LEVEL=
PORT=

# Moodle E-Hub web services
MOODLE_BASE_URL=
MOODLE_TOKEN=
# Optional limits (defaults: 30000 ms, 120000 ms, 104857600 bytes, 3 retries)
MOODLE_REQUEST_TIMEOUT_MS=
MOODLE_DOWNLOAD_TIMEOUT_MS=
MOODLE_MAX_DOWNLOAD_BYTES=
MOODLE_MAX_RETRIES=
# Optional: the day the token expires (YYYY-MM-DD), as shown in Moodle when it was issued.
# `pnpm preflight` warns as the date approaches (docs/token-rotation.md).
MOODLE_TOKEN_EXPIRES_ON=

# Extraction limits (all optional; defaults: 52428800 bytes, 2000000 chars, 60000 ms,
# 2000 archive entries, 209715200 uncompressed bytes)
EXTRACTION_MAX_INPUT_BYTES=
EXTRACTION_MAX_TEXT_CHARS=
EXTRACTION_TIMEOUT_MS=
EXTRACTION_MAX_ARCHIVE_ENTRIES=
EXTRACTION_MAX_UNCOMPRESSED_BYTES=

# Chunking (all optional; defaults: 850 target, 1000 max, 100 min, 125 overlap tokens,
# tokenizer cl100k_base to match text-embedding-3 models)
CHUNK_TARGET_TOKENS=
CHUNK_MAX_TOKENS=
CHUNK_MIN_TOKENS=
CHUNK_OVERLAP_TOKENS=
CHUNK_TOKENIZER=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
# Optional (defaults: ehub-course-content-v1, 1536 dimensions, semantic true, batch 500,
# 30000 ms, 3 retries). The API key is for local development only: leave it empty in Azure
# so Managed Identity is used.
AZURE_SEARCH_INDEX_NAME=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_VECTOR_DIMENSIONS=
AZURE_SEARCH_SEMANTIC_ENABLED=
AZURE_SEARCH_BATCH_SIZE=
AZURE_SEARCH_REQUEST_TIMEOUT_MS=
AZURE_SEARCH_MAX_RETRIES=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Local development only: leave empty in Azure so Managed Identity is used.
AZURE_OPENAI_API_KEY=

# Embeddings (optional). Defaults: model text-embedding-3-small, 1536 dimensions (must equal
# AZURE_SEARCH_VECTOR_DIMENSIONS), version 1, 64 inputs and 100000 tokens per request,
# 8191 tokens per input, 2 concurrent requests, 120 requests per minute, 30000 ms, 4 retries.
# EMBEDDING_CACHE_DIR stores vectors on disk; protect it like the course content itself.
AZURE_OPENAI_TOKEN_SCOPE=
AZURE_OPENAI_EMBEDDING_MODEL=
AZURE_OPENAI_EMBEDDING_DIMENSIONS=
AZURE_OPENAI_EMBEDDING_SEND_DIMENSIONS=
EMBEDDING_VERSION=
EMBEDDING_BATCH_SIZE=
EMBEDDING_MAX_BATCH_TOKENS=
EMBEDDING_MAX_INPUT_TOKENS=
EMBEDDING_MAX_CONCURRENCY=
EMBEDDING_REQUESTS_PER_MINUTE=
EMBEDDING_REQUEST_TIMEOUT_MS=
EMBEDDING_MAX_RETRIES=
EMBEDDING_CACHE_DIR=

# Answer generation (optional). Uses AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_CHAT_DEPLOYMENT and the
# same key/scope as embeddings. Defaults: 1200 output tokens, 60000 ms, 2 retries, json_schema
# responses, 1000-character questions, 12000 context tokens, 4000-character answers, at least 1
# supporting chunk. CHAT_TEMPERATURE is not sent unless set (reasoning models reject it).
CHAT_TEMPERATURE=
CHAT_MAX_OUTPUT_TOKENS=
CHAT_REQUEST_TIMEOUT_MS=
CHAT_MAX_RETRIES=
CHAT_RESPONSE_FORMAT=
RAG_MAX_QUESTION_CHARS=
RAG_MAX_CONTEXT_TOKENS=
RAG_MAX_ANSWER_CHARS=
RAG_MIN_SUPPORTING_CHUNKS=
RAG_MIN_TOP_RERANKER_SCORE=
# Citation links are shown only for these hosts (comma-separated); defaults to the host of
# MOODLE_BASE_URL. Excerpts default to 200 characters.
CITATION_ALLOWED_HOSTS=
CITATION_EXCERPT_CHARS=

# Moodle synchronisation (phase 11). Choose the courses: SYNC_COURSE_IDS (comma-separated) or
# SYNC_ALL_COURSES=true. Hidden content is excluded unless SYNC_INCLUDE_HIDDEN=true. Defaults:
# state in .ehub/sync-state, 5 attempts, retry delay 600000 ms doubling to 86400000 ms, course
# lock 1800000 ms, deletion guard 0.5 of a course's resources once more than 5 would go.
# Uses AZURE_TENANT_ID below.
SYNC_COURSE_IDS=
SYNC_ALL_COURSES=
SYNC_INCLUDE_HIDDEN=
SYNC_STATE_DIR=
SYNC_MAX_ATTEMPTS=
SYNC_RETRY_BASE_DELAY_MS=
SYNC_RETRY_MAX_DELAY_MS=
SYNC_LEASE_TTL_MS=
SYNC_MAX_DELETE_FRACTION=
SYNC_MAX_DELETE_MINIMUM=

# Answer API server (`pnpm api serve`, phase 12). Listens on API_HOST (default 127.0.0.1) and
# PORT. Callers sign in with Entra ID (ENTRA_* below). Development only: API_DEV_MOCK_IDENTITY=true
# (ignored unless NODE_ENV=development) treats callers naming API_DEV_MOCK_USER_ID (default
# dev-mock-user) as a test user with access to API_DEV_MOCK_COURSE_IDS. Without MOODLE_TOKEN
# (no course authorisation), signed-in users see no courses unless API_DEV_ENTRA_COURSE_IDS
# (development only) grants test courses to every signed-in user.
API_HOST=
API_REQUEST_TIMEOUT_MS=
# Abuse limits (docs/security.md). Per signed-in user: questions and feedback submissions per
# window; beyond that the API answers 429 with Retry-After. Across all users: answers generated
# at once. Defaults: 20 questions and 60 feedback per 60 seconds, 16 concurrent answers.
API_RATE_LIMIT_QUESTIONS=
API_RATE_LIMIT_WINDOW_SECONDS=
API_RATE_LIMIT_FEEDBACK=
API_MAX_CONCURRENT_ANSWERS=
API_DEV_MOCK_IDENTITY=
API_DEV_MOCK_USER_ID=
API_DEV_MOCK_COURSE_IDS=
API_DEV_ENTRA_COURSE_IDS=
# DEVELOPMENT ONLY: app roles for the mock identity (e.g. EHub.ContentAdministrator), to try /admin.
API_DEV_MOCK_ROLES=

# Moodle identity mapping and course authorisation (phase 14, docs/authorization.md). On when
# MOODLE_TOKEN is set. Defaults: state in .ehub/identity-state, email matching on, no UPN rule,
# 300 s cache, no stale grace, 5000 cache entries, invalidations read every 5 s.
IDENTITY_STATE_DIR=
IDENTITY_EMAIL_MATCHING=
IDENTITY_UPN_USERNAME_RULE=
IDENTITY_UPN_DOMAINS=
AUTHZ_CACHE_TTL_SECONDS=
AUTHZ_STALE_GRACE_SECONDS=
AUTHZ_CACHE_MAX_ENTRIES=
AUTHZ_INVALIDATION_POLL_SECONDS=

# Administration area at /admin (phase 15, docs/admin.md). Off by default. ADMIN_SPA_CLIENT_ID is
# the admin page's single-page-app registration; it must also be in ENTRA_ALLOWED_CLIENT_APP_IDS.
# Defaults: state in .ehub/admin-state, 90 days retention.
ADMIN_UI_ENABLED=
ADMIN_SPA_CLIENT_ID=
ADMIN_PUBLIC_ORIGIN=
ADMIN_STATE_DIR=
ADMIN_RETENTION_DAYS=

# Entra ID access tokens for the answer API (phase 13, docs/entra-sso.md). Not secrets.
# ENTRA_API_CLIENT_ID is the API app registration; ENTRA_ALLOWED_CLIENT_APP_IDS lists the apps
# allowed to call it (the bot registration). ENTRA_ALLOWED_TENANT_IDS defaults to AZURE_TENANT_ID.
# Defaults: scope access_as_user, 120 s clock tolerance, https://login.microsoftonline.com.
ENTRA_API_CLIENT_ID=
ENTRA_API_APP_ID_URI=
ENTRA_ALLOWED_CLIENT_APP_IDS=
ENTRA_ALLOWED_TENANT_IDS=
ENTRA_API_SCOPE=
ENTRA_CLOCK_TOLERANCE_SECONDS=
ENTRA_AUTHORITY_HOST=

# Teams bot (`pnpm teams:dev`, phase 12). Defaults: port 3978, API http://127.0.0.1:3000, 60000 ms,
# 8 questions at once, 24000-byte cards. The client ID is the bot's Entra app registration (also
# the manifest's botId); the secret is for local development only. TEAMS_DEV_MOCK_IDENTITY and
# TEAMS_DEV_ALLOW_UNAUTHENTICATED are development-only switches (see docs/teams-app.md).
# TEAMS_SSO_CONNECTION_NAME is the Azure Bot OAuth connection for single sign-on (docs/entra-sso.md).
TEAMS_BOT_PORT=
TEAMS_SSO_CONNECTION_NAME=
TEAMS_BOT_CLIENT_ID=
TEAMS_BOT_CLIENT_SECRET=
TEAMS_BOT_TENANT_ID=
TEAMS_API_BASE_URL=
TEAMS_API_TIMEOUT_MS=
TEAMS_DEV_MOCK_IDENTITY=
TEAMS_DEV_MOCK_USER_ID=
TEAMS_DEV_ALLOW_UNAUTHENTICATED=
TEAMS_ALLOWED_LINK_HOSTS=
TEAMS_MAX_CONCURRENT_QUESTIONS=
TEAMS_CARD_MAX_BYTES=

# Teams app manifest (teams:validate / teams:package). Not secrets, but environment-specific.
# TEAMS_SSO_RESOURCE defaults to api://botid-<TEAMS_BOT_CLIENT_ID>.
TEAMS_APP_ID=
TEAMS_SSO_RESOURCE=
TEAMS_DEVELOPER_NAME=
TEAMS_WEBSITE_URL=
TEAMS_PRIVACY_URL=
TEAMS_TERMS_URL=

# Microsoft Entra ID (client secret is for local development only; Azure uses Managed Identity)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Monitoring (docs/observability.md). Leave empty locally: telemetry is then off and only JSON
# logs are written. A secret: use a Key Vault reference in Azure. Automatic instrumentation and
# the process resource detector stay off whatever OTEL_* variables say.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Local development only (docker-compose.yml) — not used by the application
LOCAL_POSTGRES_PASSWORD=

# Retrieval (all optional). Defaults: top K 8, at most 3 chunks per resource, 24 candidates,
# semantic ranking on. Score thresholds are off unless set; see docs/retrieval.md for scales.
RETRIEVAL_TOP_K=
RETRIEVAL_MAX_CHUNKS_PER_RESOURCE=
RETRIEVAL_CANDIDATE_COUNT=
RETRIEVAL_SEMANTIC_RANKING=
RETRIEVAL_MIN_SCORE=
RETRIEVAL_MIN_RERANKER_SCORE=

# E-Hub Teams Knowledge Assistant — environment variables.
# Copy to .env for local development and fill in values there. Never commit .env.
# Deployed environments read these from Azure Key Vault / app settings, not from a file.

# Runtime
NODE_ENV=
LOG_LEVEL=
PORT=

# Moodle E-Hub web services
MOODLE_BASE_URL=
MOODLE_TOKEN=
# Optional limits (defaults: 30000 ms, 120000 ms, 104857600 bytes, 3 retries)
MOODLE_REQUEST_TIMEOUT_MS=
MOODLE_DOWNLOAD_TIMEOUT_MS=
MOODLE_MAX_DOWNLOAD_BYTES=
MOODLE_MAX_RETRIES=

# Extraction limits (all optional; defaults: 52428800 bytes, 2000000 chars, 60000 ms,
# 2000 archive entries, 209715200 uncompressed bytes)
EXTRACTION_MAX_INPUT_BYTES=
EXTRACTION_MAX_TEXT_CHARS=
EXTRACTION_TIMEOUT_MS=
EXTRACTION_MAX_ARCHIVE_ENTRIES=
EXTRACTION_MAX_UNCOMPRESSED_BYTES=

# Chunking (all optional; defaults: 850 target, 1000 max, 100 min, 125 overlap tokens,
# tokenizer cl100k_base to match text-embedding-3 models)
CHUNK_TARGET_TOKENS=
CHUNK_MAX_TOKENS=
CHUNK_MIN_TOKENS=
CHUNK_OVERLAP_TOKENS=
CHUNK_TOKENIZER=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
# Optional (defaults: ehub-course-content-v1, 1536 dimensions, semantic true, batch 500,
# 30000 ms, 3 retries). The API key is for local development only: leave it empty in Azure
# so Managed Identity is used.
AZURE_SEARCH_INDEX_NAME=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_VECTOR_DIMENSIONS=
AZURE_SEARCH_SEMANTIC_ENABLED=
AZURE_SEARCH_BATCH_SIZE=
AZURE_SEARCH_REQUEST_TIMEOUT_MS=
AZURE_SEARCH_MAX_RETRIES=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Local development only: leave empty in Azure so Managed Identity is used.
AZURE_OPENAI_API_KEY=

# Embeddings (optional). Defaults: model text-embedding-3-small, 1536 dimensions (must equal
# AZURE_SEARCH_VECTOR_DIMENSIONS), version 1, 64 inputs and 100000 tokens per request,
# 8191 tokens per input, 2 concurrent requests, 120 requests per minute, 30000 ms, 4 retries.
# EMBEDDING_CACHE_DIR stores vectors on disk; protect it like the course content itself.
AZURE_OPENAI_TOKEN_SCOPE=
AZURE_OPENAI_EMBEDDING_MODEL=
AZURE_OPENAI_EMBEDDING_DIMENSIONS=
AZURE_OPENAI_EMBEDDING_SEND_DIMENSIONS=
EMBEDDING_VERSION=
EMBEDDING_BATCH_SIZE=
EMBEDDING_MAX_BATCH_TOKENS=
EMBEDDING_MAX_INPUT_TOKENS=
EMBEDDING_MAX_CONCURRENCY=
EMBEDDING_REQUESTS_PER_MINUTE=
EMBEDDING_REQUEST_TIMEOUT_MS=
EMBEDDING_MAX_RETRIES=
EMBEDDING_CACHE_DIR=

# Answer generation (optional). Uses AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_CHAT_DEPLOYMENT and the
# same key/scope as embeddings. Defaults: 1200 output tokens, 60000 ms, 2 retries, json_schema
# responses, 1000-character questions, 12000 context tokens, 4000-character answers, at least 1
# supporting chunk. CHAT_TEMPERATURE is not sent unless set (reasoning models reject it).
CHAT_TEMPERATURE=
CHAT_MAX_OUTPUT_TOKENS=
CHAT_REQUEST_TIMEOUT_MS=
CHAT_MAX_RETRIES=
CHAT_RESPONSE_FORMAT=
RAG_MAX_QUESTION_CHARS=
RAG_MAX_CONTEXT_TOKENS=
RAG_MAX_ANSWER_CHARS=
RAG_MIN_SUPPORTING_CHUNKS=
RAG_MIN_TOP_RERANKER_SCORE=
# Citation links are shown only for these hosts (comma-separated); defaults to the host of
# MOODLE_BASE_URL. Excerpts default to 200 characters.
CITATION_ALLOWED_HOSTS=
CITATION_EXCERPT_CHARS=

# Microsoft Entra ID (client secret is for local development only; Azure uses Managed Identity)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Monitoring
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Local development only (docker-compose.yml) — not used by the application
LOCAL_POSTGRES_PASSWORD=

# Retrieval (all optional). Defaults: top K 8, at most 3 chunks per resource, 24 candidates,
# semantic ranking on. Score thresholds are off unless set; see docs/retrieval.md for scales.
RETRIEVAL_TOP_K=
RETRIEVAL_MAX_CHUNKS_PER_RESOURCE=
RETRIEVAL_CANDIDATE_COUNT=
RETRIEVAL_SEMANTIC_RANKING=
RETRIEVAL_MIN_SCORE=
RETRIEVAL_MIN_RERANKER_SCORE=

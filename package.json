{
  "name": "ehub-teams-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "E-Hub Teams Knowledge Assistant: grounded answers from Moodle E-Hub content inside Microsoft Teams.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "clean": "pnpm -r run clean && node scripts/clean.mjs coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r run typecheck && tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "node scripts/security-report.mjs",
    "api": "pnpm --silent --filter @ehub/api run cli",
    "diagnose": "pnpm --silent --filter @ehub/api run cli diagnose",
    "indexer": "pnpm --silent --filter @ehub/indexer run cli",
    "evaluation": "pnpm --silent --filter @ehub/api run evaluation",
    "identity": "pnpm --silent --filter @ehub/api run identity",
    "authorization": "pnpm --silent --filter @ehub/api run authorization",
    "teams:validate": "pnpm --silent --filter @ehub/teams-app run manifest validate",
    "teams:package": "pnpm --silent --filter @ehub/teams-app run manifest package",
    "teams:dev": "pnpm --silent --filter @ehub/teams-app run dev",
    "infra:validate": "node infrastructure/scripts/validate-bicep.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs"
  },
  "devDependencies": {
    "@ehub/moodle-client": "workspace:*",
    "@ehub/shared": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}

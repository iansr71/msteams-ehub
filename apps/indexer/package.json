{
  "name": "@ehub/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Moodle content indexer.",
  "type": "module",
  "exports": {
    ".": {
      "@ehub/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "node ../../scripts/clean.mjs dist tsconfig.build.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx --conditions=@ehub/source src/cli.ts",
    "start": "node dist/cli.js"
  },
  "bin": {
    "ehub-indexer": "./dist/cli.js"
  },
  "dependencies": {
    "@ehub/moodle-client": "workspace:*",
    "@ehub/shared": "workspace:*",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "htmlparser2": "12.0.0",
    "js-tiktoken": "1.0.21",
    "pdfjs-dist": "6.4.299",
    "saxes": "6.0.0",
    "yauzl": "3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "yazl": "3.3.1"
  }
}

{
  "name": "@ehub/teams-app",
  "version": "0.1.0",
  "private": true,
  "description": "Microsoft Teams personal app (implemented in phase 12).",
  "type": "module",
  "exports": {
    ".": {
      "@ehub/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "node ../../scripts/clean.mjs dist tsconfig.build.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

{
  "name": "@ehub/teams-app",
  "version": "0.1.0",
  "private": true,
  "description": "Microsoft Teams personal app: the E-Hub Knowledge Assistant bot.",
  "type": "module",
  "exports": {
    ".": {
      "@ehub/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "node ../../scripts/clean.mjs dist tsconfig.build.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx --conditions=@ehub/source src/main.ts",
    "start": "node dist/main.js",
    "manifest": "tsx --conditions=@ehub/source src/manifest/cli.ts"
  },
  "dependencies": {
    "@ehub/shared": "workspace:*",
    "@microsoft/teams.api": "2.1.1",
    "@microsoft/teams.apps": "2.1.1",
    "@microsoft/teams.cards": "2.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@microsoft/app-manifest": "1.1.3",
    "ajv": "8.18.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1"
  }
}

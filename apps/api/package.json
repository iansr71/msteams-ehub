{
  "name": "@ehub/api",
  "version": "0.1.0",
  "private": true,
  "description": "E-Hub Knowledge Assistant API.",
  "type": "module",
  "exports": {
    ".": {
      "@ehub/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "admin-ui"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "node ../../scripts/clean.mjs dist tsconfig.build.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p admin-ui/tsconfig.json",
    "cli": "tsx --conditions=@ehub/source src/cli.ts",
    "start": "node dist/cli.js",
    "evaluation": "tsx --conditions=@ehub/source src/evaluationCli.ts",
    "identity": "tsx --conditions=@ehub/source src/identityCli.ts",
    "authorization": "tsx --conditions=@ehub/source src/authorizationCli.ts"
  },
  "bin": {
    "ehub-api": "./dist/cli.js",
    "ehub-evaluation": "./dist/evaluationCli.js",
    "ehub-identity": "./dist/identityCli.js",
    "ehub-authorization": "./dist/authorizationCli.js"
  },
  "dependencies": {
    "@azure/msal-browser": "5.25.1",
    "@ehub/indexer": "workspace:*",
    "@ehub/moodle-client": "workspace:*",
    "@ehub/shared": "workspace:*",
    "jose": "6.2.12",
    "zod": "^4.6.7"
  }
}

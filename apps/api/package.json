{
  "name": "@ehub/api",
  "version": "0.1.0",
  "private": true,
  "description": "E-Hub Knowledge Assistant API.",
  "type": "module",
  "exports": {
    ".": {
      "@ehub/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "node ../../scripts/clean.mjs dist tsconfig.build.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx --conditions=@ehub/source src/cli.ts",
    "start": "node dist/cli.js",
    "evaluation": "tsx --conditions=@ehub/source src/evaluationCli.ts"
  },
  "bin": {
    "ehub-api": "./dist/cli.js",
    "ehub-evaluation": "./dist/evaluationCli.js"
  },
  "dependencies": {
    "@ehub/shared": "workspace:*",
    "zod": "^4.6.7"
  }
}

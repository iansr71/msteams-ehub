# Application settings for `pnpm release:verify -- --env-file <path>` and `pnpm teams:package`.
#
# Copy to release.env (not committed: .gitignore) and fill in the real identifiers. These are
# the values the Teams package is built from and the ones that have to agree with each other for
# sign-in to work; `pnpm release:verify` checks them without contacting anything.
#
# NO SECRETS BELONG IN THIS FILE. The Moodle token and the bot client secret go straight into Key
# Vault, and `pnpm preflight` checks them in the deployed environment, where they already are
# (docs/production-deployment.md, docs/token-rotation.md).

# Entra app registration for the answer API (docs/entra-sso.md)
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_APP_ID_URI=api://00000000-0000-0000-0000-000000000000
ENTRA_API_SCOPE=access_as_user
# The staff tenant, and the bot's registration: the API accepts tokens only from these.
ENTRA_ALLOWED_TENANT_IDS=00000000-0000-0000-0000-000000000000
ENTRA_ALLOWED_CLIENT_APP_IDS=00000000-0000-0000-0000-000000000000

# Teams app (docs/teams-deployment.md)
# The Teams app ID is the manifest's own identifier, not the bot's client ID.
TEAMS_APP_ID=00000000-0000-0000-0000-000000000000
TEAMS_BOT_CLIENT_ID=00000000-0000-0000-0000-000000000000
TEAMS_BOT_TENANT_ID=00000000-0000-0000-0000-000000000000
# What the bot asks Entra for a token for: the API's application ID URI, optionally with the
# scope appended. A mismatch here is the most common cause of "sign-in worked but the answer
# API rejected the token".
TEAMS_SSO_RESOURCE=api://00000000-0000-0000-0000-000000000000
TEAMS_API_BASE_URL=https://example.com
TEAMS_DEVELOPER_NAME=
TEAMS_WEBSITE_URL=https://example.com
TEAMS_PRIVACY_URL=https://example.com/privacy
TEAMS_TERMS_URL=https://example.com/terms
# Hosts whose links may appear in a card. The Moodle host must be here or citations lose their
# "Open in E-Hub" buttons.
TEAMS_ALLOWED_LINK_HOSTS=
# Used only to check the line above; no token, so nothing secret.
MOODLE_BASE_URL=https://example.com

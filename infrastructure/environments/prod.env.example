# E-Hub prod environment settings for infrastructure/scripts (deploy, what-if, rollback, ...).
# Copy to prod.env (not committed: .gitignore) and replace every placeholder. The scripts refuse
# to run while a placeholder value remains. No secrets go in this file: the Moodle token and the
# bot client secret go straight into Key Vault (docs/infrastructure.md, step 4).

# Azure
EHUB_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
EHUB_RESOURCE_GROUP=rg-ehub-prod
# South Africa North keeps the data in the country; check Azure AI Search and Container Apps
# availability for your subscription in the chosen region.
EHUB_LOCATION=southafricanorth
EHUB_NAME_PREFIX=ehub
# Your Entra object ID (filled in automatically from `az login` when empty); for a pipeline, the
# service principal's object ID and EHUB_DEPLOYER_PRINCIPAL_TYPE=ServicePrincipal.
EHUB_DEPLOYER_OBJECT_ID=
EHUB_DEPLOYER_PRINCIPAL_TYPE=User
# Pin the base image by digest for repeatable builds, e.g. node:22-bookworm-slim@sha256:...
EHUB_NODE_IMAGE=node:22-bookworm-slim
# true: one static outbound IP through a NAT gateway (for a Moodle firewall allowlist).
EHUB_ENABLE_VNET=false

# Azure OpenAI (deployed separately; the identities get Cognitive Services OpenAI User on it)
EHUB_OPENAI_ACCOUNT_NAME=
EHUB_OPENAI_RESOURCE_GROUP=
EHUB_OPENAI_ENDPOINT=https://example.com
EHUB_OPENAI_CHAT_DEPLOYMENT=
EHUB_OPENAI_EMBEDDING_DEPLOYMENT=
EHUB_EMBEDDING_DIMENSIONS=1536

# Moodle
EHUB_MOODLE_BASE_URL=https://example.com
# Pilot courses only, comma-separated Moodle course IDs.
EHUB_SYNC_COURSE_IDS=

# Entra app registrations (docs/entra-sso.md, docs/admin.md)
EHUB_ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
EHUB_BOT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Empty: no administration page.
EHUB_ADMIN_SPA_CLIENT_ID=
EHUB_SSO_CONNECTION_NAME=ehub-sso

# Teams app package (package-teams-app)
EHUB_TEAMS_APP_ID=00000000-0000-0000-0000-000000000000
EHUB_TEAMS_DEVELOPER_NAME=Skin Renewal
EHUB_TEAMS_WEBSITE_URL=https://example.com
EHUB_TEAMS_PRIVACY_URL=https://example.com/privacy
EHUB_TEAMS_TERMS_URL=https://example.com/terms

# Availability alert recipients, comma-separated; empty for none.
EHUB_ALERT_EMAILS=
